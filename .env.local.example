# Shared password required to access the app
APP_PASSWORD=change-me

# Random secret used to sign the session cookie (e.g. `openssl rand -base64 32`)
SESSION_SECRET=change-me-too

# Where photos, thumbnails, and the SQLite database are stored.
# Locally this can stay relative; on Railway set it to the mounted volume path (e.g. /data).
DATA_DIR=./data
