# Shared password required to access the app
APP_PASSWORD=change-me

# Random secret used to sign the session cookie (e.g. `openssl rand -base64 32`)
SESSION_SECRET=change-me-too

# Turso database. Locally these can be left unset to use data/catalog.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob store for photos and thumbnails (also needed locally).
# Get it with `vercel env pull` or from the store's settings in Vercel.
BLOB_READ_WRITE_TOKEN=
